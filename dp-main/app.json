{
  "expo": {
    "name": "Dentist Planner",
    "icon": "./assets/icon.png",
    "slug": "doctor-planner",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "doctorplanner",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.doctorplanner.app",
      "supportsRtl": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "لتحديد مواقيت الصلاة واتجاه القبلة لموقعك."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "لمسح الباركود والتقاط الصور لإيقاف المنبّه.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "للسماح بفتح التطبيق بالبصمة."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "للإملاء الصوتي لملاحظاتك.",
          "speechRecognitionPermission": "للإملاء الصوتي لملاحظاتك.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "للسماح باختيار شعار التطبيق أو العيادة من الصور."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "icon": "./assets/notification-icon.png",
          "defaultChannel": "events",
          "sounds": [
            "./assets/sounds/adhan.mp3"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayWidget",
              "label": "جدول اليوم",
              "description": "مواعيد ومناوبات اليوم مع الصلاة القادمة",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WeatherWidget",
              "label": "الطقس",
              "description": "طقس مدينتك برسمة مجسّمة تتغيّر بحسب الحالة",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PrayerWidget",
              "label": "الصلاة القادمة",
              "description": "الصلاة القادمة ووقتها في حماه",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "AlarmWidget",
              "label": "المنبّه القادم",
              "description": "أقرب منبّه فعّال ووقته",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TasksWidget",
              "label": "المهام",
              "description": "المهام المفتوحة مرتّبة بالأهمية",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ClinicWidget",
              "label": "العيادة اليوم",
              "description": "مواعيد اليوم والموعد التالي",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuranWidget",
              "label": "تابع القراءة",
              "description": "آخر سورة وصفحة وصلت إليها",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "CountdownWidget",
              "label": "لحظتي القادمة",
              "description": "أقرب لحظة بعدّاد تنازلي بلونها",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "CountdownListWidget",
              "label": "قائمة لحظاتي",
              "description": "أقرب لحظاتك القادمة بألوانها",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
