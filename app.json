{
  "expo": {
    "name": "Dentist Planner",
    "icon": "./assets/icon.png",
    "slug": "doctor-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "doctorplanner",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.doctorplanner.app",
      "supportsRtl": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#FFFFFF" }],
      ["expo-image-picker", { "photosPermission": "للسماح باختيار شعار التطبيق أو العيادة من الصور." }],
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "icon": "./assets/notification-icon.png",
          "defaultChannel": "events"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayWidget",
              "label": "جدول اليوم",
              "description": "مواعيد ومناوبات اليوم مع الصلاة القادمة",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PrayerWidget",
              "label": "الصلاة القادمة",
              "description": "الصلاة القادمة ووقتها في حماه",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
